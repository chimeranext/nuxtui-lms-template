# Template (demo/Envato) — copy to .env, never commit secrets.
# Neon demo project (pooled):
DATABASE_URL=postgresql://user:pass@ep-demo-pool.neon.tech/demo-template?sslmode=require
# Auth.js v5:
NUXT_AUTH_SECRET=change-me-32-chars-min
# Bunny (template ships local mock; leave empty for mock):
NUXT_PUBLIC_VIDEO_CDN=
NUXT_PUBLIC_SITE_URL=http://localhost:3000
# Academy prod overrides these in academy/.env (academy-prod project + real Bunny keys).
